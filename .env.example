# Copy this file to .env and fill in the keys. Never commit .env.

# ChatGPT responder (optional judge with --judge openai-gpt-nano)
OPENAI_API_KEY=
# Gemini responder AND the default judge/translator (free tier)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# https://platform.deepseek.com
DEEPSEEK_API_KEY=
# BytePlus ModelArk, ap-southeast region (format: ark-...)
DOUBAO_API_KEY=
# Qwen (Alibaba Model Studio, INTERNATIONAL/Singapore region): https://modelstudio.console.alibabacloud.com
QWEN_API_KEY=
# Zhipu GLM (z.ai international, free glm-4.5-flash): https://z.ai/manage-apikey/apikey-list
GLM_API_KEY=
# Kimi (Moonshot AI international): https://platform.moonshot.ai/console/api-keys
KIMI_API_KEY=
